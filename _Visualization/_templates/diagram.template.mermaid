%% ============================================================================
%% Mermaid Diagram Template
%% ============================================================================
%% scenario_id: {SCENARIO_ID}
%% scenario_name: {SCENARIO_NAME}
%% actors: {ACTORS}
%% last_updated: {DATE}
%% ============================================================================
%%
%% USAGE:
%% 1. Copy this template to your scenario folder as diagram.mermaid
%% 2. Replace placeholders {SCENARIO_ID}, {SCENARIO_NAME}, etc.
%% 3. Choose the appropriate diagram type below
%% 4. Remove unused diagram sections
%%
%% SUPPORTED DIAGRAM TYPES:
%% - sequenceDiagram: For user flows, API calls, interactions
%% - flowchart: For decision flows, process diagrams
%% - stateDiagram-v2: For state machines, lifecycle diagrams
%%
%% ACTOR REFERENCE:
%% - 1-1: License Server (Control-plane)
%% - 1-2: Consumer Server (Control-plane)
%% - 2: Tenant Server (Data-plane)
%% - 3: B2B User
%% - 4: Individual User
%% ============================================================================

sequenceDiagram
    autonumber

    %% Define participants
    participant U as User
    participant CS as Consumer Server (1-2)
    participant LS as License Server (1-1)
    participant TS as Tenant Server (2)
    participant DB as Database

    Note over U,DB: {SCENARIO_NAME}

    %% Main flow
    U->>CS: 1. Request action
    CS->>DB: 2. Query/Update
    DB-->>CS: 3. Response
    CS-->>U: 4. Result

    Note over U,DB: Flow Complete

%% ============================================================================
